# Magento behind Caddy. Caddy terminates HTTPS and sends every request here, over plain HTTP inside the Docker network.
# The Magento rules themselves are Magento's own nginx.conf.sample, which comes with Magento (in the store root).
#
# When it starts, the nginx image fills in the HYVA_DOMAIN and HYVA_STORE_CODE values from .env (only variables whose
# name starts with HYVA_, see docker-compose.yml). Every other variable here is nginx's own.

upstream fastcgi_backend {
    server php:9000;
}

# Which store view a request is for, from its host name: the Hyvä domain runs the Hyvä store view, any other host
# (the Luma domain) runs the default one. Sent to PHP as MAGE_RUN_CODE / MAGE_RUN_TYPE by fastcgi_params.
map $host $mage_run_code {
    default "";
    ${HYVA_DOMAIN} ${HYVA_STORE_CODE};
}
map $host $mage_run_type {
    default "";
    ${HYVA_DOMAIN} store;
}

# Caddy tells whether the shopper used HTTPS in X-Forwarded-Proto. PHP gets HTTPS=on, so Magento builds https:// links
# and does not redirect in a loop.
map $http_x_forwarded_proto $forwarded_https {
    default "";
    https on;
}
map $http_x_forwarded_proto $forwarded_scheme {
    default $scheme;
    https https;
}

server {
    listen 80;
    server_name _;

    # The shopper's real IP address, which Caddy sends in X-Real-IP (trusted from private Docker networks only).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Real-IP;

    client_max_body_size 64m;

    set $MAGE_ROOT /var/www/html;
    set $MAGE_MODE production;

    # IRIOS Media push service worker. The module answers /irios-sw.js from Magento (a router, no file on disk), so
    # the request must reach index.php. This internal rewrite does that with no redirect: browsers refuse a service
    # worker whose URL redirects. It also covers /<store code>/irios-sw.js, for stores with the store code in the URL.
    location ~ ^/(?:[A-Za-z0-9_]+/)?irios-sw\.js$ {
        rewrite ^ /index.php last;
    }

    include /var/www/html/nginx.conf.sample;
}
