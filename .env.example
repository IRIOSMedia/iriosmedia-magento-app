# Settings of this store. Copy this file to .env and change the values marked "change me".
# .env is git-ignored: it holds passwords. docker-compose.yml and the bin/ scripts read it.
#
# Put a value in single quotes when it contains "$" or spaces (the basic auth hash and the open paths do).

# Name of this Docker Compose project: it prefixes the containers and volumes. Change it only to run two copies of
# this store on the same machine.
COMPOSE_PROJECT_NAME=irios-magento-app

# --- Domains and HTTPS -----------------------------------------------------------------------------------------------

# The domain of each store view. On a server, both need a DNS A record pointing to the server (see docs/aws.md).
# On your computer, use *.localhost names: browsers send them to your own machine with no setup.
LUMA_DOMAIN=shop.example.com            # change me. The Luma store view, and the address of the admin
HYVA_DOMAIN=hyva.shop.example.com       # change me. The Hyvä store view (see docs/hyva.md)

# How the store gets HTTPS (docker/caddy/<TLS_MODE>.Caddyfile):
#   letsencrypt          Caddy gets real certificates from Let's Encrypt and renews them by itself. For a server whose
#                        DNS points straight to it, with ports 80 and 443 open.
#   cloudflare-flexible  Cloudflare's proxy serves HTTPS to shoppers and talks plain HTTP to the server (Cloudflare
#                        SSL/TLS mode "Flexible"). The server has no certificate. See "Behind Cloudflare" in docs/aws.md.
#   internal             HTTPS with Caddy's own local authority, for your computer (see "Quick start" in README.md).
#   http                 plain HTTP, for your computer only (push notifications need HTTPS).
TLS_MODE=letsencrypt

# Let's Encrypt writes here about certificate problems. Required with TLS_MODE=letsencrypt.
ACME_EMAIL=you@example.com              # change me

# Ports published on the host. Keep 80 and 443 on a server. On a computer where they are taken, use others, for
# example 8080 and 8443: the store is then at https://<domain>:8443/ (or http://<domain>:8080/ with TLS_MODE=http).
HTTP_PORT=80
HTTPS_PORT=443

# --- Password protection (optional) ----------------------------------------------------------------------------------

# With a user and a hash, the browser asks for a user name and password before it shows anything (HTTP basic auth).
# Leave BASIC_AUTH_USER empty for a public store.
# To make the hash of a password, run (it asks for the password twice and prints the hash):
#   docker compose run --rm --no-deps caddy caddy hash-password
# Paste the hash between single quotes, for example BASIC_AUTH_HASH='$2a$14$...'
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Paths left open without the password. /rest/* lets the IRIOS Media sync service in with its integration token,
# /irios-sw.js lets browsers update the push service worker, and /media/* lets IRIOS Media fetch the product images
# the catalog points to. See "Security notes" in README.md.
BASIC_AUTH_OPEN_PATHS='/rest/* /irios-sw.js /media/*'

# --- Magento ---------------------------------------------------------------------------------------------------------

# Magento Open Source version. The IRIOS Media module is tested end to end on 2.4.8-p5. When Adobe publishes a newer
# 2.4.8 patch, set it here before the first setup, or use bin/update.sh magento <version> on an installed store.
MAGENTO_VERSION=2.4.8-p5

# Luma sample data (products, categories, customers, CMS pages): yes or no. Recommended for a test store.
SAMPLE_DATA=yes

MAGENTO_LOCALE=en_US
MAGENTO_CURRENCY=EUR
MAGENTO_TIMEZONE=UTC

# The admin is at https://<LUMA_DOMAIN>/<ADMIN_PATH>. A less obvious path gets fewer login attempts from bots.
# Letters, digits and _ only (Magento rejects anything else), for example backoffice_7f3k.
ADMIN_PATH=admin
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com           # change me
ADMIN_FIRSTNAME=Store
ADMIN_LASTNAME=Admin
# Leave empty to get a random password. bin/setup.sh prints it once, at the end of the first installation.
ADMIN_PASSWORD=

# Two-factor authentication for the admin: off or on.
# off: recommended for a test store behind password protection. Magento's two-factor setup sends an email, and a
#      test store usually sends no email, so with "on" you could not finish the first login.
# on:  for a public store. Read "Two-factor authentication" in README.md before you switch it on.
TWO_FACTOR=off

# --- Database and other passwords ------------------------------------------------------------------------------------

# Make each one with: openssl rand -hex 24
DB_NAME=magento
DB_USER=magento
DB_PASSWORD=change-me                   # change me
DB_ROOT_PASSWORD=change-me-too          # change me

# --- IRIOS Media module ----------------------------------------------------------------------------------------------

# Where the module comes from (Composer package iriosmedia/module-irios-media):
#   git        a branch or tag of github.com/IRIOSMedia/iriosmedia-magento-module (IRIOS_MODULE_REF). Works before
#              the first release, and to try a branch.
#   release    the zip of a GitHub release (IRIOS_MODULE_VERSION, empty for the latest release).
#   packagist  from Packagist, once the package is published there (IRIOS_MODULE_VERSION, empty for the latest).
IRIOS_MODULE_SOURCE=git
IRIOS_MODULE_REF=main
IRIOS_MODULE_VERSION=
IRIOS_MODULE_REPO=https://github.com/IRIOSMedia/iriosmedia-magento-module.git

# --- Hyvä store view -------------------------------------------------------------------------------------------------

# Where the Hyvä theme comes from (it is free and open source). See docs/hyva.md.
#   github     Hyvä's public GitHub repositories. Needs no key.
#   packagist  Hyvä's Composer repository, with the free key of a hyva.io account: put the key in auth.json and your
#              project name in HYVA_PROJECT.
#   none       no Hyvä store view: only the Luma one.
HYVA_SOURCE=github
HYVA_PROJECT=
# Code of the Hyvä store view (also its website code). The IRIOS Media sync service uses store view codes.
HYVA_STORE_CODE=hyva

# --- Memory -----------------------------------------------------------------------------------------------------------

# standard (8 GB server or more) or small (2 GB test server: heavy steps run one at a time, with 4 GB of swap).
# The values below are for "standard". For "small", use the values in the comments (see "Server size" in docs/aws.md).
MEMORY_PROFILE=standard

OPENSEARCH_HEAP=1g                      # small: 512m

DB_BUFFER_POOL_SIZE=1G                  # small: 128M
DB_MAX_CONNECTIONS=150                  # small: 50
DB_TMP_TABLE_SIZE=64M                   # small: 16M
DB_SORT_BUFFER_SIZE=2M                  # small: 256K
DB_JOIN_BUFFER_SIZE=2M                  # small: 256K

# PHP-FPM workers. Each one may use up to PHP_MEMORY_LIMIT while it runs a request.
PHP_FPM_PM=dynamic                      # small: ondemand
PHP_FPM_MAX_CHILDREN=10                 # small: 3
PHP_FPM_START_SERVERS=2
PHP_FPM_MIN_SPARE_SERVERS=1
PHP_FPM_MAX_SPARE_SERVERS=3
PHP_FPM_IDLE_TIMEOUT=30s
# Magento needs 2G for its own commands (compilation, static content).
PHP_MEMORY_LIMIT=2G

# Cache and full page cache. Sessions are in a separate instance that never drops anything.
VALKEY_MAXMEMORY=512mb                  # small: 64mb

# Hard memory caps per container (Docker syntax: 512m, 2g). 0 means no cap. Optional.
DB_MEM_LIMIT=0
OPENSEARCH_MEM_LIMIT=0
PHP_MEM_LIMIT=0

# Parallel jobs for static content deployment. small: 1
STATIC_JOBS=4
